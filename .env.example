# Copy to .env (cp .env.example .env && chmod 600 .env), then fill in values there.
# Read by Docker Compose (image versions) and passed to Grafana (env_file), so every
# GF_* line below is a Grafana setting. Uncomment a section when its video needs it,
# fill in the values, then run: docker compose up -d
# Keep notes on their own lines: text after a value can become part of the value.
# Never commit .env; .gitignore excludes it.

# --- Image versions -------------------------------------------------------------
# Change a version, then: docker compose pull && docker compose up -d
GRAFANA_VERSION=13.2.4
PROMETHEUS_VERSION=v3.15.1
BLACKBOX_VERSION=v0.29.1

# --- Grafana address --------------------------------------------------------------
# HTTPS (default): Grafana serves https://grafana.lan itself, using the lab CA
# certificate in ./certs (see certs/README.txt). Compose maps port 443 to
# Grafana's 3000. ROOT_URL is the address Grafana uses in links and in the Entra
# redirect, which Entra only accepts over HTTPS.
GF_SERVER_PROTOCOL=https
GF_SERVER_DOMAIN=grafana.lan
GF_SERVER_ROOT_URL=https://grafana.lan/
GF_SERVER_CERT_FILE=/etc/grafana/certs/grafana.crt
GF_SERVER_CERT_KEY=/etc/grafana/certs/grafana.key

# HTTP instead (http://grafana.lan:3000, no Entra login): comment out the five
# lines above and uncomment these three, then in docker-compose.yml swap the
# grafana port lines, and in prometheus.yml comment out the grafana job's
# scheme and tls_config lines. Then: docker compose up -d && docker compose restart prometheus
# GF_SERVER_PROTOCOL=http
# GF_SERVER_DOMAIN=grafana.lan
# GF_SERVER_ROOT_URL=http://grafana.lan:3000/

# --- Email alerts (email notifications video) -------------------------------------
# Gmail: turn on 2-step verification, create an app password at
# https://myaccount.google.com/apppasswords and use that as GF_SMTP_PASSWORD
# (the 16-character app password, not your Gmail password).
# The old video set SKIP_VERIFY to true; Gmail's certificate is valid, so keep false.
# GF_SMTP_ENABLED=true
# GF_SMTP_HOST=smtp.gmail.com:587
# GF_SMTP_USER=you@gmail.com
# GF_SMTP_PASSWORD=
# GF_SMTP_FROM_ADDRESS=you@gmail.com
# GF_SMTP_FROM_NAME=Grafana
# GF_SMTP_STARTTLS_POLICY=MandatoryStartTLS
# GF_SMTP_SKIP_VERIFY=false

# --- Azure data sources (cloud videos 1, 2 and 4) ---------------------------------
# Lets the Azure Monitor and Azure Prometheus data sources sign in to Azure.
GF_AUTH_AZURE_AUTH_ENABLED=true
# From: az ad sp create-for-rbac -n sp-hol-grafana ...
#   AZ_TENANT        = "tenant" in the output (Entra directory ID)
#   AZ_SUBSCRIPTION  = az account show --query id -o tsv
#   AZ_CLIENT_ID     = "appId"
#   AZ_CLIENT_SECRET = "password" (expires after one year by default)
# provisioning/datasources/azure-monitor.yaml.example reads them (copy it to .yaml to use it).
# AZ_TENANT=
# AZ_SUBSCRIPTION=
# AZ_CLIENT_ID=
# AZ_CLIENT_SECRET=

# --- Log Analytics sender (cloud video 2) -----------------------------------------
# Used by send_holdemo.py, not by Grafana.
#   DCE_LOGS_URL = dce-hol-grafana > Overview > Logs ingestion URL
#   DCR_ID       = dcr-hol-demo > JSON view > immutableId (starts "dcr-")
# DCE_LOGS_URL=
# DCR_ID=

# --- Entra ID login (cloud video 3) -----------------------------------------------
# Full steps: docs/entra-id.md. App registration with redirect URI
# https://grafana.lan/login/azuread (must match GF_SERVER_ROOT_URL exactly), and
# app roles with values Admin, Editor and Viewer assigned to users in Enterprise
# applications. Grafana's Entra login reads roles from app roles only.
#   CLIENT_ID     = app registration > Overview > Application (client) ID
#   CLIENT_SECRET = Certificates & secrets > New client secret > Value (shown once)
#   <tenant-id>   = app registration > Overview > Directory (tenant) ID
# ROLE_ATTRIBUTE_STRICT=true refuses users with no app role.
# GF_AUTH_AZUREAD_ENABLED=true
# GF_AUTH_AZUREAD_NAME=Microsoft Entra ID
# GF_AUTH_AZUREAD_CLIENT_ID=
# GF_AUTH_AZUREAD_CLIENT_SECRET=
# GF_AUTH_AZUREAD_SCOPES=openid email profile
# GF_AUTH_AZUREAD_AUTH_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/authorize
# GF_AUTH_AZUREAD_TOKEN_URL=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token
# GF_AUTH_AZUREAD_ALLOW_SIGN_UP=true
# GF_AUTH_AZUREAD_ROLE_ATTRIBUTE_STRICT=true

# --- AWS CloudWatch (AWS video, parked) -------------------------------------------
# Access key for IAM user grafana-cloudwatch-demo, which has only the policy from
# Grafana's CloudWatch data source documentation.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-west-2
